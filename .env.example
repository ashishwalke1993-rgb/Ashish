# ── Telegram ──────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID
# Step 1: Send any message to your bot
# Step 2: Visit https://api.telegram.org/bot<TOKEN>/getUpdates
# Step 3: Copy the "id" value from "chat" object
TELEGRAM_CHAT_ID=your_chat_id_here

# ── TMDB ──────────────────────────────────────────────────
# Free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Reddit (optional but recommended for real reviews) ────
# Create a free "script" app at https://www.reddit.com/prefs/apps
# Takes ~2 minutes. No verification needed.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MovieBot/1.0 by YourUsername

# ── Schedule ──────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
SEND_HOUR=10
SEND_MINUTE=0

# ── Behavior ──────────────────────────────────────────────
# How many days back to look for new releases (default: 7)
DAYS_LOOKBACK=7
# Max movies to cover per day (default: 5)
MAX_MOVIES_PER_RUN=5
